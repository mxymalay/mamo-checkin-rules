{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mamo source rule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "source", "courses", "images"],
  "if": {"required": ["attachments"]},
  "then": {"properties": {"source": {"const": "ed"}}},
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!.*(?:builtin|demo))[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+(?![\\s\\S])"},
    "version": {"type": "string", "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}$"},
    "name": {"type": "object", "additionalProperties": false, "required": ["en"], "properties": {"en": {"$ref": "#/definitions/text"}, "zh_CN": {"$ref": "#/definitions/text"}, "zh_TW": {"$ref": "#/definitions/text"}}},
    "source": {"enum": ["gmail", "moodle", "ed"]},
    "courses": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2,10}\\d{3,6}$"}},
    "keywords": {"type": "object", "additionalProperties": false, "properties": {"navigation": {"$ref": "#/definitions/words"}, "context": {"$ref": "#/definitions/words"}}},
    "images": {"type": "object", "additionalProperties": false, "required": ["selectors"], "properties": {
      "selectors": {"$ref": "#/definitions/selectors"},
      "excludeSelectors": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/definitions/selector"}},
      "minWidth": {"$ref": "#/definitions/dimension"}, "minHeight": {"$ref": "#/definitions/dimension"}, "maxHeight": {"$ref": "#/definitions/dimension"}
    }},
    "attachments": {"type": "object", "additionalProperties": false, "required": ["selectors"], "properties": {"selectors": {"$ref": "#/definitions/selectors"}}}
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "selector": {"type": "string", "allOf": [{"$ref": "#/definitions/text"}], "format": "mamo-selector"},
    "words": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/definitions/text"}},
    "selectors": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/definitions/selector"}},
    "dimension": {"type": "integer", "minimum": 1, "maximum": 4000}
  },
  "$comment": "Run format.js validation as well: UTF-8 64KiB budget and minHeight <= maxHeight are cross-field constraints. Register mamo-selector using validateSelector."
}
